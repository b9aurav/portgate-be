# PortGate — environment variables
# Copy this file to .env and fill in your values.

# ── Google GenAI ──────────────────────────────────────────
# Required for live PDF extraction via Gemini multimodal.
# Get yours at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Optional: override the default Gemini model
# GEMINI_MODEL=gemini-3.5-flash-lite

# ── CORS ─────────────────────────────────────────────────
# Comma-separated allowed origins, or * for development.
# ALLOWED_ORIGINS=http://localhost:3000,https://yourapp.com

# ── Server ────────────────────────────────────────────────
# LOG_LEVEL=info

# ── Supabase ──────────────────────────────────────────────
# Project URL and Secret (service_role) key for database & storage
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key_here

